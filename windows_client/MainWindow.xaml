<Window x:Class="MobilModemClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MobilModem — Operatör Korumalı L3 Ağ Tüneli" 
        Height="740" Width="540"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F12"
        Foreground="#E4E4E7"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#09090B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#27272A"/>
                                <Setter Property="Foreground" Value="#71717A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- 1. Header Banner -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="⚡" FontSize="26" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <StackPanel>
                    <TextBlock Text="MobilModem v1.0" FontSize="20" FontWeight="Bold" Foreground="#FAFAFA"/>
                    <TextBlock Text="Mobil Operatör Kısıtlamasız Tam L3 Tünel Adaptörü" FontSize="12" Foreground="#A1A1AA"/>
                </StackPanel>
            </StackPanel>

            <!-- 2. Mode Selection Card -->
            <Border Style="{StaticResource ModernCard}">
                <StackPanel>
                    <TextBlock Text="Bağlantı Modu" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="#FAFAFA"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton x:Name="RbUsbMode" Content="⚡ USB Kablo Modu (Ultra Hız)" IsChecked="True" 
                                     Foreground="#E4E4E7" FontWeight="SemiBold" Margin="0,0,20,0" Checked="Mode_Changed"/>
                        <RadioButton x:Name="RbP2pMode" Content="📶 Wi-Fi Direct Modu (P2P)" 
                                     Foreground="#E4E4E7" FontWeight="SemiBold" Checked="Mode_Changed"/>
                    </StackPanel>

                    <!-- P2P Settings Box -->
                    <StackPanel x:Name="P2pSettingsBox" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock Text="Hedef Ağ Geçidi IP:" FontSize="12" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtTargetIp" Text="192.168.49.1" Background="#27272A" Foreground="#FAFAFA" 
                                 BorderThickness="1" BorderBrush="#3F3F46" Padding="8,6" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. Hardware & Protection Status Card -->
            <Border Style="{StaticResource ModernCard}">
                <StackPanel>
                    <TextBlock Text="Sistem Donanım ve Güvenlik Durumu" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="#FAFAFA"/>
                    <TextBlock x:Name="LblAdbStatus" Text="ADB Cihazı: ⏳ Bekleniyor..." FontSize="13" Margin="0,0,0,6" Foreground="#E4E4E7"/>
                    <TextBlock x:Name="LblWintunStatus" Text="Wintun Sanal Kart: ❌ Pasif" FontSize="13" Margin="0,0,0,6" Foreground="#E4E4E7"/>
                    <TextBlock x:Name="LblTtlStatus" Text="TTL Koruması: ❌ Kapalı (Varsayılan 128)" FontSize="13" Foreground="#E4E4E7"/>
                </StackPanel>
            </Border>

            <!-- 4. Live Stats (Ping & Flow) -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#18181B" CornerRadius="12" Padding="14" BorderBrush="#27272A" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Canlı Gecikme (Ping)" FontSize="11" Foreground="#71717A" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LblPing" Text="-- ms" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#18181B" CornerRadius="12" Padding="14" BorderBrush="#27272A" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Tünel Akışı" FontSize="11" Foreground="#71717A" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LblTunnelFlow" Text="Bağlantı Yok" FontSize="15" FontWeight="Bold" Foreground="#F43F5E" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 5. Main Action Button & Status -->
            <StackPanel Margin="0,0,0,14">
                <Button x:Name="BtnAction" Content="TÜNELİ BAŞLAT" Style="{StaticResource ActionButton}" Click="BtnAction_Click"/>
                <TextBlock x:Name="LblStatusDesc" Text="Bağlantı Kurulmaya Hazır" FontSize="12" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- 6. Mobile APK Downloader / Installer Card (Kullanıcı İsteği) -->
            <Border Style="{StaticResource ModernCard}">
                <StackPanel>
                    <TextBlock Text="📱 Mobil Uygulama (APK) Yükleyici" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="#FAFAFA"/>
                    <TextBlock Text="Android cihazınıza MobilModem uygulamasını tek tıkla kurun veya tarayıcıdan indirin:" 
                               FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="BtnSideloadApk" Content="📲 Telefona Kur (ADB)" Style="{StaticResource SecondaryButton}" 
                                Margin="0,0,10,0" Click="BtnSideloadApk_Click"/>
                        <Button x:Name="BtnDownloadLink" Content="🌐 İndirme Sunucusu Başlat" Style="{StaticResource SecondaryButton}" 
                                Click="BtnDownloadLink_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="LblApkStatus" Text="" FontSize="11" Foreground="#34D399" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 7. Collapsible Log Window -->
            <StackPanel Margin="0,4,0,0">
                <Button x:Name="BtnToggleLog" Content="▼ Olay Günlüğünü Göster" Style="{StaticResource SecondaryButton}" 
                        HorizontalAlignment="Left" Click="BtnToggleLog_Click"/>
                
                <Border x:Name="LogBorder" Visibility="Collapsed" Background="#141416" CornerRadius="10" 
                        Padding="12" Margin="0,10,0,0" BorderBrush="#27272A" BorderThickness="1">
                    <TextBox x:Name="TxtLogs" Height="140" Background="Transparent" Foreground="#D4D4D8" 
                             BorderThickness="0" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
